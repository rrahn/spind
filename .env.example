# Copy this file to `.env` and adjust the values.
# `.env` is git-ignored; never commit real secrets. `just` auto-loads it.

# --- Postgres (E1, E6) ---
POSTGRES_USER=locker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lockerdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend API (E4) ---
# Placeholder admin token guarding the admin router until real auth (E10).
ADMIN_API_KEY=change-me

# --- Optional development-only RAS simulator (existing Express/MySQL app) ---
# Generate independent values: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Disabled by default. Keep the key stable to decrypt codes across restarts.
RAS_SIMULATOR_ENABLED=false
RAS_SIMULATOR_TOKEN=
RAS_SIMULATOR_KEY=
